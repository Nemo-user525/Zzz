XRAY_DB_PATH=data/xray.sqlite3
LLM_PROVIDER=offline
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
OCR_PROVIDER=disabled
INGEST_MAX_DOCUMENTS=220
# Current adapter is deliberately serial; values other than 1 are rejected.
INGEST_MAX_CONCURRENCY=1
INGEST_REQUEST_INTERVAL=0.35

# QCC API 736: server-side only; both credentials and API permission are required.
QCC_APP_KEY=
QCC_SECRET_KEY=

# Consumer investigation: optional licensed search API; otherwise public web search.
TAVILY_API_KEY=
# LangGraph uses the existing LLM_* settings above. No separate agent vendor required.
