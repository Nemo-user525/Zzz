XRAY_DB_PATH=data/xray.sqlite3
LLM_PROVIDER=offline
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
OCR_PROVIDER=disabled
INGEST_MAX_DOCUMENTS=220
# Current adapter is deliberately serial; values other than 1 are rejected.
INGEST_MAX_CONCURRENCY=1
INGEST_REQUEST_INTERVAL=0.35

# QCC API 736: server-side only; both credentials and API permission are required.
QCC_APP_KEY=
QCC_SECRET_KEY=
# Optional web-session override; blank uses configs/qcc-web-session.json.
# The localhost UI can override or clear the session until the backend restarts.
# Used only for QCC company /firm/<id>.html or /firm_<id>.html pages; no redirects.
QCC_WEB_COOKIE=

# Consumer investigation: optional licensed search API; otherwise public web search.
TAVILY_API_KEY=
# Consumer reasoning: auto prefers free cloud ONLY when its key is configured;
# otherwise uses the locally installed Ollama model. Never switches to paid models.
CONSUMER_MODEL_PROVIDER=auto
CONSUMER_LOCAL_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENROUTER_API_KEY=
CONSUMER_CLOUD_MODEL=qwen/qwen3.8-27b:free
# Optional licensed Bocha search, used together with public search / Tavily.
BOCHA_API_KEY=
# Official QCC MCP: copy Streamable HTTP URL + Bearer key from agent.qcc.com.
# Do not put secrets in the frontend, git, URLs, screenshots or chat.
QCC_MCP_URL=
QCC_MCP_API_KEY=
# Tool name -> company keyword argument; match tools/list for your official server.
QCC_MCP_TOOLS={"get_company_registration_info":"auto"}
